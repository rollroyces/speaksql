{"version": 2, "width": 100, "height": 28, "timestamp": 1790599739, "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}, "title": "SpeakSQL \u2014 vendor_overrides"}
[0.0, "o", "\u001b[H\u001b[2J"]
[0.0, "o", "\u001b[?25l"]
[0.0, "o", "\u001b[1;36mSpeakSQL \u2014 vendor_overrides\u001b[0m  \u001b[2m# recorded demo\u001b[0m\n"]
[0.536, "o", "\u001b[2m# Raw SQLGlot emit \u2014 DuckDB's DATE_DIFF args are reversed.\u001b[0m\n"]
[0.536, "o", "\u001b[1;32m$\u001b[0m .venv/bin/speaksql format --target duckdb 'SELECT DATE_DIFF('\\''second'\\'', end_at, start_at) AS elapsed FROM events' 2>&1\n"]
[0.61, "o", "SELECT DATE_DIFF('second', end_at, start_at) AS elapsed FROM events\n"]
[0.625, "o", "$ "]
[1.959, "o", "\u001b[2m# Seed a DuckDB file with two timestamped rows.\u001b[0m\n"]
[1.959, "o", "\u001b[1;32m$\u001b[0m .venv/bin/python -c \"import duckdb; con = duckdb.connect('/tmp/events.duck'); con.execute('CREATE TABLE events (start_at TIMESTAMP, end_at TIMESTAMP)'); con.execute(\\\"INSERT INTO events VALUES (TIMESTAMP '2026-01-15 10:00:00', TIMESTAMP '2026-01-22 10:00:00')\\\"); con.execute(\\\"INSERT INTO events VALUES (TIMESTAMP '2026-02-01 09:00:00', TIMESTAMP '2026-02-08 09:00:00')\\\"); print('seeded', con.execute('SELECT COUNT(*) FROM events').fetchone()[0], 'rows')\" 2>&1\n"]
[2.013, "o", "Traceback (most recent call last):\n  File \"<string>\", line 1, in <module>\n_duckdb.CatalogException: Catalog Error: Table with name \"events\" already exists!\n"]
[2.02, "o", "$ "]
[3.358, "o", "\u001b[2m# Vendor override flips the args AND runs the query on DuckDB.\u001b[0m\n"]
[3.358, "o", "\u001b[1;32m$\u001b[0m echo \"SELECT DATE_DIFF('second', end_at, start_at) AS elapsed FROM events\" | .venv/bin/speaksql ask --sql --dialect duckdb --execute-on duckdb --db-path /tmp/events.duck 2>&1 | tail -15\n"]
[3.576, "o", "\n=== Execution on duckdb ===\n{\n  \"executed\": true,\n  \"backend\": \"duckdb\",\n  \"row_count\": 2,\n  \"rows\": [\n    [\n      -604800\n    ],\n    [\n      -604800\n    ]\n  ]\n}\n"]
[3.577, "o", "$ "]
