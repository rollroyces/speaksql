{"version": 2, "width": 100, "height": 28, "timestamp": 1789657969, "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}, "title": "SpeakSQL \u2014 format"}
[0.0, "o", "\u001b[H\u001b[2J"]
[0.0, "o", "\u001b[?25l"]
[0.0, "o", "\u001b[1;36mSpeakSQL \u2014 format\u001b[0m  \u001b[2m# recorded demo\u001b[0m\n"]
[0.526, "o", "\u001b[2m# Compact form (single line).\u001b[0m\n"]
[0.526, "o", "\u001b[1;32m$\u001b[0m echo 'select    a,b,  c FROM tbl WHERE x=1' | .venv/bin/speaksql format --target postgres 2>&1\n"]
[0.623, "o", "SELECT a, b, c FROM tbl WHERE x = 1\n"]
[0.64, "o", "$ "]
[1.975, "o", "\u001b[2m# Pretty-print mode (multi-line).\u001b[0m\n"]
[1.976, "o", "\u001b[1;32m$\u001b[0m .venv/bin/speaksql format --pretty 'SELECT id, name, email FROM users WHERE active = TRUE ORDER BY id LIMIT 10' 2>&1 | head -15\n"]
[2.058, "o", "SELECT\n  id,\n  name,\n  email\nFROM users\nWHERE\n  active = TRUE\nORDER BY\n  id\nLIMIT 10\n"]
[2.079, "o", "$ "]
[3.416, "o", "\u001b[2m# Convert DuckDB \u2192 Snowflake.\u001b[0m\n"]
[3.416, "o", "\u001b[1;32m$\u001b[0m .venv/bin/speaksql format --target snowflake --dialect duckdb 'SELECT NOW()' 2>&1\n"]
[3.514, "o", "SELECT NOW()\n"]
[3.529, "o", "$ "]
